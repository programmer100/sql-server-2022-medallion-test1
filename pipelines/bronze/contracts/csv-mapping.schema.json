{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sqlserver-medallion/csv-mapping.schema.json",
  "title": "SQL Server Medallion CSV-to-Bronze mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "version", "source", "strictHeader", "target", "columns"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delimiter", "quote", "hasHeader", "encoding", "treatEmptyAsNull"],
      "properties": {
        "delimiter": { "type": "string", "minLength": 1, "maxLength": 1 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 1 },
        "hasHeader": { "const": true },
        "encoding": { "type": "string", "minLength": 1 },
        "treatEmptyAsNull": { "type": "boolean" }
      }
    },
    "strictHeader": { "type": "boolean" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "table", "requireHeap"],
      "properties": {
        "schema": { "const": "bronze" },
        "table": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" },
        "requireHeap": { "type": "boolean" }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "landingMaxLength", "businessType", "optional"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" },
          "landingMaxLength": {
            "oneOf": [
              { "const": -1 },
              { "type": "integer", "minimum": 1 }
            ]
          },
          "businessType": { "type": "string", "minLength": 1 },
          "businessMaxLength": { "type": ["integer", "null"], "minimum": 1 },
          "optional": { "type": "boolean" }
        }
      }
    }
  }
}
